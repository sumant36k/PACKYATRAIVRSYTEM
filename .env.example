# Exotel (+91 India) Server Configuration
# Copy this file to .env on your local machine and fill in your Exotel API credentials.
# Never commit your .env file or expose API credentials in client code.

PORT="3000"

# Required Exotel Credentials (from Exotel Dashboard -> API Settings)
EXOTEL_ACCOUNT_SID="packyatra1"
EXOTEL_API_KEY="your_exotel_api_key"
EXOTEL_API_TOKEN="your_exotel_api_token"

# Optional: Leave blank to auto-detect Mumbai (api.in.exotel.com) or Singapore (api.exotel.com)
EXOTEL_SUBDOMAIN=""

# Your Exotel Virtual Number (ExoPhone) & App Bazaar IVR Flow ID
EXOTEL_CALLER_ID="08047291107"
EXOTEL_FLOW_APP_ID="1386346"

# Default Agent Mobile Number (+91)
MY_MOBILE_NUMBER="+919916109192"
